<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#E60F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time's Up!"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#F87171"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app or device has been locked by your parent."
        android:textSize="15sp"
        android:textColor="#E2E8F0"
        android:textAlignment="center"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnEmergencyCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📞 Emergency Call (112)"
        android:backgroundTint="#334155"
        android:textColor="#FFFFFF" />

</LinearLayout>
